{
  "v1": {
    "bindings": {
      "Announce": {
        "tagged_union": {
          "variants": {
            "compiled": {
              "description": "One compile unit of a source finished, or was loaded from the cache.",
              "maskoid": {
                "ref": "Compiled"
              }
            },
            "dirty": {
              "description": "The file (or something it depends on) changed; its previous results are void.",
              "maskoid": {
                "record": {
                  "fields": {
                    "path": {
                      "maskoid": "string"
                    }
                  }
                }
              }
            },
            "removed": {
              "description": "The file was deleted.",
              "maskoid": {
                "record": {
                  "fields": {
                    "path": {
                      "maskoid": "string"
                    }
                  }
                }
              }
            },
            "settled": {
              "description": "Nothing is pending for the source any more.",
              "maskoid": {
                "record": {
                  "fields": {
                    "path": {
                      "maskoid": "string"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "ClientMessage": {
        "record": {
          "fields": {
            "id": {
              "maskoid": "int"
            },
            "req": {
              "maskoid": {
                "ref": "Request"
              }
            }
          }
        }
      },
      "CompileError": {
        "record": {
          "fields": {
            "location": {
              "maskoid": {
                "ref": "Location"
              }
            },
            "message": {
              "maskoid": "string"
            },
            "related": {
              "maskoid": {
                "list": {
                  "ref": "Related"
                }
              }
            }
          }
        }
      },
      "Compiled": {
        "record": {
          "description": "One compile of a source. A source is compiled once per import state it is\nimported under, so a file can have several.",
          "fields": {
            "ended_ms": {
              "maskoid": "int"
            },
            "errors": {
              "maskoid": {
                "list": {
                  "ref": "CompileError"
                }
              }
            },
            "import_state": {
              "maskoid": "int"
            },
            "logs": {
              "maskoid": {
                "list": {
                  "ref": "Log"
                }
              }
            },
            "source": {
              "maskoid": {
                "ref": "Source"
              }
            },
            "started_ms": {
              "maskoid": "int"
            }
          }
        }
      },
      "ExprMeta": {
        "record": {
          "description": "The type an expression evaluated to in one compile of a source.",
          "fields": {
            "import_state": {
              "maskoid": "int"
            },
            "meta": {
              "maskoid": {
                "ref": "Meta"
              }
            },
            "source": {
              "maskoid": {
                "ref": "Source"
              }
            }
          }
        }
      },
      "FileState": {
        "record": {
          "description": "The cached state of one file: whether it is being compiled and the results of\nevery compile of it the server knows.",
          "fields": {
            "compiles": {
              "maskoid": {
                "list": {
                  "ref": "Compiled"
                }
              }
            },
            "dirty": {
              "maskoid": "bool"
            }
          }
        }
      },
      "Location": {
        "record": {
          "fields": {
            "expr": {
              "description": "The `id` of the expression in the module's JSON; none for the module as a whole.",
              "maskoid": {
                "option": "int"
              }
            },
            "source": {
              "maskoid": {
                "ref": "Source"
              }
            }
          }
        }
      },
      "Log": {
        "record": {
          "fields": {
            "at_ms": {
              "maskoid": "int"
            },
            "message": {
              "maskoid": "string"
            }
          }
        }
      },
      "Meta": {
        "record": {
          "description": "A type's metadata: an id for the kind of type, a data object the type chose, and the\nfields a value of the type has.",
          "fields": {
            "data": {
              "maskoid": "any"
            },
            "fields": {
              "maskoid": {
                "list": {
                  "ref": "MetaField"
                }
              }
            },
            "id": {
              "maskoid": "int"
            },
            "kind": {
              "maskoid": "string"
            }
          }
        }
      },
      "MetaField": {
        "record": {
          "fields": {
            "data": {
              "maskoid": "any"
            },
            "meta": {
              "description": "The id of the field's type's metadata, when the type has one.",
              "maskoid": {
                "option": "int"
              }
            },
            "name": {
              "maskoid": "string"
            }
          }
        }
      },
      "Related": {
        "record": {
          "fields": {
            "description": {
              "maskoid": "string"
            },
            "location": {
              "maskoid": {
                "ref": "Location"
              }
            }
          }
        }
      },
      "Request": {
        "tagged_union": {
          "variants": {
            "expr_meta": {
              "description": "The metadata of every type an expression evaluated to, from each compile that\nevaluated it.",
              "maskoid": {
                "record": {
                  "fields": {
                    "expr": {
                      "maskoid": "int"
                    },
                    "source": {
                      "maskoid": {
                        "ref": "Source"
                      }
                    }
                  }
                }
              }
            },
            "file_state": {
              "description": "The cached state of one file: whether it is being compiled and the results of\nevery compile of it the server knows.",
              "maskoid": {
                "record": {
                  "fields": {
                    "path": {
                      "maskoid": "string"
                    }
                  }
                }
              }
            },
            "flush": {
              "description": "Compile everything pending now, even while paused, and reply once every\naffected source has settled.",
              "maskoid": "null"
            },
            "meta": {
              "description": "Metadata records by id, for following a field's reference to its type.",
              "maskoid": {
                "record": {
                  "fields": {
                    "ids": {
                      "maskoid": {
                        "list": "int"
                      }
                    }
                  }
                }
              }
            },
            "pause": {
              "description": "While paused the server still announces `Dirty` for changed files but doesn't\ncompile them until unpaused or flushed.",
              "maskoid": {
                "record": {
                  "fields": {
                    "paused": {
                      "maskoid": "bool"
                    }
                  }
                }
              }
            },
            "scope_meta": {
              "description": "The named scope entries visible to an expression, from each compile of its source:\nwhat was bound before its enclosing statement and not unbound since.",
              "maskoid": {
                "record": {
                  "fields": {
                    "expr": {
                      "maskoid": "int"
                    },
                    "source": {
                      "maskoid": {
                        "ref": "Source"
                      }
                    }
                  }
                }
              }
            },
            "source_read": {
              "description": "The text of a module the editor can't read itself (a remote source).",
              "maskoid": {
                "record": {
                  "fields": {
                    "source": {
                      "maskoid": {
                        "ref": "Source"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "Response": {
        "tagged_union": {
          "variants": {
            "expr_meta": {
              "maskoid": {
                "record": {
                  "fields": {
                    "metas": {
                      "maskoid": {
                        "list": {
                          "ref": "ExprMeta"
                        }
                      }
                    }
                  }
                }
              }
            },
            "failed": {
              "maskoid": {
                "record": {
                  "fields": {
                    "message": {
                      "maskoid": "string"
                    }
                  }
                }
              }
            },
            "file_state": {
              "maskoid": {
                "ref": "FileState"
              }
            },
            "flush": {
              "description": "Every compile unit compiled by the flush.",
              "maskoid": {
                "record": {
                  "fields": {
                    "compiled": {
                      "maskoid": {
                        "list": {
                          "ref": "Compiled"
                        }
                      }
                    }
                  }
                }
              }
            },
            "meta": {
              "description": "Records in the order asked, leaving out ids that don't exist.",
              "maskoid": {
                "record": {
                  "fields": {
                    "metas": {
                      "maskoid": {
                        "list": {
                          "ref": "Meta"
                        }
                      }
                    }
                  }
                }
              }
            },
            "pause": {
              "maskoid": "null"
            },
            "scope_meta": {
              "maskoid": {
                "record": {
                  "fields": {
                    "scopes": {
                      "maskoid": {
                        "list": {
                          "ref": "ScopeMeta"
                        }
                      }
                    }
                  }
                }
              }
            },
            "source_read": {
              "maskoid": {
                "record": {
                  "fields": {
                    "text": {
                      "maskoid": {
                        "option": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "ScopeEntry": {
        "record": {
          "fields": {
            "meta": {
              "maskoid": {
                "option": {
                  "ref": "Meta"
                }
              }
            },
            "name": {
              "maskoid": "string"
            }
          }
        }
      },
      "ScopeMeta": {
        "record": {
          "fields": {
            "entries": {
              "description": "Innermost last; a name bound twice appears twice.",
              "maskoid": {
                "list": {
                  "ref": "ScopeEntry"
                }
              }
            },
            "import_state": {
              "maskoid": "int"
            },
            "source": {
              "maskoid": {
                "ref": "Source"
              }
            }
          }
        }
      },
      "ServerMessage": {
        "tagged_union": {
          "variants": {
            "ev": {
              "maskoid": {
                "record": {
                  "fields": {
                    "ev": {
                      "maskoid": {
                        "ref": "Announce"
                      }
                    }
                  }
                }
              }
            },
            "res": {
              "maskoid": {
                "record": {
                  "fields": {
                    "id": {
                      "maskoid": "int"
                    },
                    "res": {
                      "maskoid": {
                        "ref": "Response"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "Source": {
        "tagged_union": {
          "variants": {
            "local": {
              "maskoid": {
                "record": {
                  "fields": {
                    "path": {
                      "maskoid": "string"
                    }
                  }
                }
              }
            },
            "remote": {
              "description": "The server's own name for a non-file source, usable in `SourceRead`.",
              "maskoid": {
                "record": {
                  "fields": {
                    "spec": {
                      "maskoid": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "default": "ServerMessage"
  }
}
