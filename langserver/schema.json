{
  "v1": {
    "bindings": {
      "Announce": {
        "tagged_union": {
          "variants": {
            "compiled": {
              "maskoid": {
                "ref": "Compiled"
              }
            },
            "dirty": {
              "maskoid": {
                "record": {
                  "fields": {
                    "path": {
                      "maskoid": "string"
                    }
                  }
                }
              }
            },
            "removed": {
              "maskoid": {
                "record": {
                  "fields": {
                    "path": {
                      "maskoid": "string"
                    }
                  }
                }
              }
            },
            "settled": {
              "maskoid": {
                "record": {
                  "fields": {
                    "path": {
                      "maskoid": "string"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "ClientMessage": {
        "record": {
          "fields": {
            "id": {
              "maskoid": "int"
            },
            "req": {
              "maskoid": {
                "ref": "Request"
              }
            }
          }
        }
      },
      "CompileError": {
        "record": {
          "fields": {
            "location": {
              "maskoid": {
                "ref": "Location"
              }
            },
            "message": {
              "maskoid": "string"
            },
            "related": {
              "maskoid": {
                "list": {
                  "ref": "Related"
                }
              }
            }
          }
        }
      },
      "Compiled": {
        "record": {
          "fields": {
            "ended_ms": {
              "maskoid": "int"
            },
            "errors": {
              "maskoid": {
                "list": {
                  "ref": "CompileError"
                }
              }
            },
            "export": {
              "maskoid": {
                "option": {
                  "ref": "Export"
                }
              }
            },
            "import_state": {
              "maskoid": "int"
            },
            "logs": {
              "maskoid": {
                "list": {
                  "ref": "Log"
                }
              }
            },
            "source": {
              "maskoid": {
                "ref": "Source"
              }
            },
            "started_ms": {
              "maskoid": "int"
            }
          }
        }
      },
      "Export": {
        "record": {
          "description": "What the module's root exported, when it compiled and exported something. The\neditor recognizes markers by `type_name`: a source-defined object the module is\nan instance of, such as `editor`.",
          "fields": {
            "exporter": {
              "description": "The artifact exporter's tag, like `record` or `source_object_value_const`.",
              "maskoid": "string"
            },
            "type_name": {
              "description": "The name of the source-defined object type the export is an instance of.",
              "maskoid": {
                "option": "string"
              }
            },
            "type_source": {
              "description": "The source defining that object type.",
              "maskoid": {
                "option": {
                  "ref": "Source"
                }
              }
            }
          }
        }
      },
      "FileState": {
        "record": {
          "fields": {
            "compiles": {
              "maskoid": {
                "list": {
                  "ref": "Compiled"
                }
              }
            },
            "dirty": {
              "maskoid": "bool"
            }
          }
        }
      },
      "Location": {
        "record": {
          "fields": {
            "expr": {
              "maskoid": {
                "option": "int"
              }
            },
            "source": {
              "maskoid": {
                "ref": "Source"
              }
            }
          }
        }
      },
      "Log": {
        "record": {
          "fields": {
            "at_ms": {
              "maskoid": "int"
            },
            "message": {
              "maskoid": "string"
            }
          }
        }
      },
      "Related": {
        "record": {
          "fields": {
            "description": {
              "maskoid": "string"
            },
            "location": {
              "maskoid": {
                "ref": "Location"
              }
            }
          }
        }
      },
      "Request": {
        "tagged_union": {
          "variants": {
            "export_read": {
              "description": "The bytes at `path` in a compile's root export: a path of record field names\nand `dir` entry names, ending at a `dir` entry, a byte array, a string or an\n`app`.",
              "maskoid": {
                "record": {
                  "fields": {
                    "import_state": {
                      "maskoid": "int"
                    },
                    "path": {
                      "maskoid": {
                        "list": "string"
                      }
                    },
                    "source": {
                      "maskoid": {
                        "ref": "Source"
                      }
                    }
                  }
                }
              }
            },
            "file_state": {
              "maskoid": {
                "record": {
                  "fields": {
                    "path": {
                      "maskoid": "string"
                    }
                  }
                }
              }
            },
            "flush": {
              "maskoid": "null"
            },
            "pause": {
              "maskoid": {
                "record": {
                  "fields": {
                    "paused": {
                      "maskoid": "bool"
                    }
                  }
                }
              }
            },
            "source_read": {
              "maskoid": {
                "record": {
                  "fields": {
                    "source": {
                      "maskoid": {
                        "ref": "Source"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "Response": {
        "tagged_union": {
          "variants": {
            "export_read": {
              "maskoid": {
                "record": {
                  "fields": {
                    "bytes_base64": {
                      "maskoid": "string"
                    }
                  }
                }
              }
            },
            "failed": {
              "maskoid": {
                "record": {
                  "fields": {
                    "message": {
                      "maskoid": "string"
                    }
                  }
                }
              }
            },
            "file_state": {
              "maskoid": {
                "ref": "FileState"
              }
            },
            "flush": {
              "maskoid": {
                "record": {
                  "fields": {
                    "compiled": {
                      "maskoid": {
                        "list": {
                          "ref": "Compiled"
                        }
                      }
                    }
                  }
                }
              }
            },
            "pause": {
              "maskoid": "null"
            },
            "source_read": {
              "maskoid": {
                "record": {
                  "fields": {
                    "text": {
                      "maskoid": {
                        "option": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "ServerMessage": {
        "tagged_union": {
          "variants": {
            "ev": {
              "maskoid": {
                "record": {
                  "fields": {
                    "ev": {
                      "maskoid": {
                        "ref": "Announce"
                      }
                    }
                  }
                }
              }
            },
            "res": {
              "maskoid": {
                "record": {
                  "fields": {
                    "id": {
                      "maskoid": "int"
                    },
                    "res": {
                      "maskoid": {
                        "ref": "Response"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "Source": {
        "tagged_union": {
          "variants": {
            "local": {
              "maskoid": {
                "record": {
                  "fields": {
                    "path": {
                      "maskoid": "string"
                    }
                  }
                }
              }
            },
            "remote": {
              "maskoid": {
                "record": {
                  "fields": {
                    "spec": {
                      "maskoid": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "default": "ServerMessage"
  }
}
